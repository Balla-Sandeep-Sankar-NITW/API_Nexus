# Neon Postgres connection string.
# Get this from your Neon project dashboard -> Connection Details.
# Must include sslmode=require for Neon.
DATABASE_URL=postgresql://<user>:<password>@<your-neon-host>.neon.tech/<dbname>?sslmode=require

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Used to build links inside verification/reset emails. Point this at your
# deployed frontend URL in production.
FRONTEND_BASE_URL=http://localhost:5173

# production (default) or development. Development lets you test sign-up/reset locally
# without an email provider by returning tokens in API responses. NEVER use it on a public server.
APP_ENV=production

# --- Email over HTTPS: free, and works on Render's free plan (SMTP ports are blocked there) ---
# 1. Create a free Brevo account (300 emails/day), 2. Settings -> SMTP & API -> create an API key,
# 3. Settings -> Senders -> add and verify the address you want emails to come from.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=API Nexus

# --- Sign in with GitHub (free) ---
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
#   Homepage URL:      your frontend URL
#   Callback URL:      <BACKEND_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of this backend, e.g. https://your-api.onrender.com
BACKEND_BASE_URL=

# --- Optional SMTP fallback (only for hosts that allow SMTP; Render free does not) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_TLS=true

# --- API Explorer ("Try it out") ---------------------------------------------
# Requests are sent FROM this server, so by default it refuses private, loopback and
# internal addresses (127.0.0.1, 10.x, 192.168.x, ...) to stop users reaching services
# only the server can see. Set to true only if the APIs you test live on a private network,
# for example when everything runs on your own machine. Link-local addresses such as the
# cloud metadata service (169.254.169.254) stay blocked either way.
TRYIT_ALLOW_PRIVATE_NETWORKS=false
TRYIT_TIMEOUT_SECONDS=15
TRYIT_MAX_RESPONSE_BYTES=2000000
TRYIT_RATE_PER_MINUTE=60
