# Neon Postgres connection string.
# Get this from your Neon project dashboard -> Connection Details.
# Must include sslmode=require for Neon.
DATABASE_URL=postgresql://<user>:<password>@<your-neon-host>.neon.tech/<dbname>?sslmode=require

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Used to build links inside verification/reset emails. Point this at your
# deployed frontend URL in production.
FRONTEND_BASE_URL=http://localhost:5173

# --- Email (optional) ---
# Leave SMTP_HOST unset to run in dev mode: verification/reset emails are
# logged to the backend console instead of sent, and the raw token is
# returned in the API response so you can still test the flow without a
# mailbox. Set these to send real email (e.g. via Gmail SMTP, SendGrid,
# Postmark, AWS SES's SMTP interface, etc.) - once SMTP_HOST is set, tokens
# are never returned over the API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_TLS=true

# --- API Explorer ("Try it out") ---------------------------------------------
# Requests are sent FROM this server, so by default it refuses private, loopback and
# internal addresses (127.0.0.1, 10.x, 192.168.x, ...) to stop users reaching services
# only the server can see. Set to true only if the APIs you test live on a private network,
# for example when everything runs on your own machine. Link-local addresses such as the
# cloud metadata service (169.254.169.254) stay blocked either way.
TRYIT_ALLOW_PRIVATE_NETWORKS=false
TRYIT_TIMEOUT_SECONDS=15
TRYIT_MAX_RESPONSE_BYTES=2000000
TRYIT_RATE_PER_MINUTE=60
