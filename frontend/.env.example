# Copy this file to .env and adjust for your environment.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Backend API base URL.
# - Leave unset (or "/api") to call the API on the same origin as this app,
#   behind a reverse proxy that forwards /api to your backend. This is what
#   the dev server does automatically (see VITE_DEV_PROXY_TARGET below).
# - Set a full URL when the backend is on a different origin, e.g. a
#   separately deployed API:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_API_BASE_URL=/api

# Dev server only: where `npm run dev` proxies /api requests to.
# Not used in a production build.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
